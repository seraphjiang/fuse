{
  "dashboard": {
    "title": "Fuse Cluster",
    "uid": "fuse-cluster",
    "timezone": "utc",
    "refresh": "15s",
    "time": { "from": "now-1h", "to": "now" },
    "templating": {
      "list": [
        {
          "name": "instance",
          "type": "query",
          "query": "label_values(fuse_queries_total, instance)",
          "datasource": "Prometheus",
          "includeAll": true,
          "multi": true,
          "current": { "text": "All", "value": "$__all" }
        }
      ]
    },
    "panels": [
      {
        "title": "Request Rate (per instance)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "rate(fuse_queries_total{instance=~\"$instance\"}[1m])",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "title": "Query Latency p50 / p95 / p99",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(fuse_query_duration_ms_bucket{instance=~\"$instance\"}[5m]))",
            "legendFormat": "p50 {{instance}}"
          },
          {
            "expr": "histogram_quantile(0.95, rate(fuse_query_duration_ms_bucket{instance=~\"$instance\"}[5m]))",
            "legendFormat": "p95 {{instance}}"
          },
          {
            "expr": "histogram_quantile(0.99, rate(fuse_query_duration_ms_bucket{instance=~\"$instance\"}[5m]))",
            "legendFormat": "p99 {{instance}}"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "ms" } }
      },
      {
        "title": "Cache Hit Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "fuse_plan_cache_hits / (fuse_plan_cache_hits + fuse_plan_cache_misses + 1)",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } }
      },
      {
        "title": "Active Queries",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "fuse_active_queries{instance=~\"$instance\"}",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "title": "Error Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "rate(fuse_queries_total{instance=~\"$instance\", status=\"error\"}[5m])",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "title": "Connector Health",
        "type": "stat",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "fuse_connector_healthy{instance=~\"$instance\"}",
            "legendFormat": "{{connector}} ({{instance}})"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "options": { "1": { "text": "Healthy", "color": "green" }, "0": { "text": "Unhealthy", "color": "red" } } }
            ]
          }
        }
      },
      {
        "title": "Rate Limit Rejections",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
        "targets": [
          {
            "expr": "rate(fuse_rate_limit_rejected{instance=~\"$instance\"}[5m])",
            "legendFormat": "{{scope}} ({{instance}})"
          }
        ]
      },
      {
        "title": "Connectors / Tenants",
        "type": "stat",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
        "targets": [
          {
            "expr": "fuse_connectors_total{instance=~\"$instance\"}",
            "legendFormat": "Connectors ({{instance}})"
          },
          {
            "expr": "fuse_tenants_total{instance=~\"$instance\"}",
            "legendFormat": "Tenants ({{instance}})"
          }
        ]
      },
      {
        "title": "Query Cost ($/query)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(fuse_query_cost_usd_bucket{instance=~\"$instance\"}[5m]))",
            "legendFormat": "p95 {{connector_type}}"
          },
          {
            "expr": "histogram_quantile(0.50, rate(fuse_query_cost_usd_bucket{instance=~\"$instance\"}[5m]))",
            "legendFormat": "p50 {{connector_type}}"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } }
      },
      {
        "title": "Plan Cache Hit Rate",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
        "targets": [
          {
            "expr": "fuse_plan_cache_hits{instance=~\"$instance\"} / (fuse_plan_cache_hits{instance=~\"$instance\"} + fuse_plan_cache_misses{instance=~\"$instance\"} + 1)",
            "legendFormat": "{{instance}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 0.5, "color": "yellow" },
                { "value": 0.8, "color": "green" }
              ]
            }
          }
        }
      }
    ]
  }
}
