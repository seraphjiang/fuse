{
  "scopeName": "source.fusesql",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-dash.fusesql", "match": "--.*$" },
        { "name": "comment.block.fusesql", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.single.fusesql", "begin": "'", "end": "'", "patterns": [{ "name": "constant.character.escape.fusesql", "match": "''" }] },
        { "name": "string.quoted.double.fusesql", "begin": "\"", "end": "\"" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.fusesql", "match": "\\b\\d+(\\.\\d+)?\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.fusesql", "match": "(?i)\\b(SELECT|FROM|WHERE|AND|OR|NOT|IN|EXISTS|BETWEEN|LIKE|IS|NULL|AS|ON|JOIN|LEFT|RIGHT|INNER|CROSS|FULL|OUTER|GROUP|BY|ORDER|ASC|DESC|HAVING|LIMIT|OFFSET|UNION|ALL|DISTINCT|CASE|WHEN|THEN|ELSE|END|INSERT|INTO|VALUES|UPDATE|SET|DELETE|CREATE|DROP|ALTER|TABLE|VIEW|INDEX|WITH|RECURSIVE|MATERIALIZED|REFRESH|EXPLAIN|ANALYZE|PREPARE|EXECUTE)\\b" },
        { "name": "constant.language.fusesql", "match": "(?i)\\b(TRUE|FALSE|NULL)\\b" },
        { "name": "storage.type.fusesql", "match": "(?i)\\b(INT|INTEGER|BIGINT|FLOAT|DOUBLE|DECIMAL|VARCHAR|TEXT|STRING|BOOLEAN|DATE|TIMESTAMP|ARRAY|MAP|STRUCT)\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "support.function.fusesql", "match": "(?i)\\b(COUNT|SUM|AVG|MIN|MAX|COALESCE|IFNULL|NULLIF|CAST|CONVERT|UPPER|LOWER|TRIM|SUBSTRING|LENGTH|CONCAT|REPLACE|ROUND|CEIL|FLOOR|ABS|MOD|NOW|DATE_TRUNC|DATE_DIFF|ROW_NUMBER|RANK|DENSE_RANK|LAG|LEAD|PERCENTILE|PERCENTILE_APPROX|OVER|PARTITION|ROWS|RANGE|UNBOUNDED|PRECEDING|FOLLOWING|CURRENT|ROW)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.fusesql", "match": "(=|<>|!=|<=|>=|<|>|\\+|-|\\*|/|%|\\|\\|)" }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "variable.other.fusesql", "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*" }
      ]
    }
  }
}
