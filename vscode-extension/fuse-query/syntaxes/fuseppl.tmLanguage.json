{
  "scopeName": "source.fuseppl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#commands" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.fuseppl", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        { "name": "string.quoted.single.fuseppl", "begin": "'", "end": "'" },
        { "name": "string.quoted.double.fuseppl", "begin": "\"", "end": "\"" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.fuseppl", "match": "\\b\\d+(\\.\\d+)?\\b" }
      ]
    },
    "commands": {
      "patterns": [
        { "name": "keyword.control.fuseppl", "match": "(?i)\\b(source|search|where|fields|rename|stats|dedup|sort|eval|head|tail|top|rare|parse|grok|dissect|lookup|join|append|subquery|fillnull|flatten|expand|trendline|kmeans|ad|ml)\\b" },
        { "name": "keyword.operator.pipe.fuseppl", "match": "\\|" },
        { "name": "constant.language.fuseppl", "match": "(?i)\\b(true|false|null)\\b" }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "support.function.fuseppl", "match": "(?i)\\b(count|sum|avg|min|max|dc|values|earliest|latest|span|by|as|like|in|between|and|or|not)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.fuseppl", "match": "(=|!=|<|>|<=|>=|\\+|-|\\*|/)" }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "variable.other.fuseppl", "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*" }
      ]
    }
  }
}
